# [1] 디스코드 봇 토큰 (Discord Developer Portal에서 획득)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# [2] 이미지를 감지할 디스코드 채널 ID (비워두면 모든 채널 감지)
DISCORD_CHANNEL_ID=

# [3] [강력 추천 / 100% 무료] 구글 Apps Script 웹 앱 URL
# 구글 시트 > 확장 프로그램 > Apps Script에 apps_script.js 내용 붙여넣고 배포한 웹 앱 URL
GAS_WEBAPP_URL=https://script.google.com/macros/s/AKfycby.../exec

# [4] 무료 Gemini API 키 (Google AI Studio에서 신용카드 없이 무료 발급)
GEMINI_API_KEY=your_gemini_api_key_here

# (선택 사항) GCP Service Account 키 방식을 사용할 경우에만 사용 (GCP 미사용 시 비워두셔도 됩니다)
SPREADSHEET_KEY=1HKKUt_nW6H01moxJwmjsdjGnEwOrKHj9Cy-AjYFWUC4
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
